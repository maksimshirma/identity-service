# Required in production (docker compose --profile prod). Falls back to an
# insecure dev default otherwise — generate with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=

PORT=3000

# Optional. Falls back to http://localhost:$PORT. Set this to the real
# public URL in any non-local deploy — Better-Auth uses it for callback
# URLs, cookie domain inference, and the OpenAPI `servers` entry Swagger UI
# uses to build "Try it out" request URLs.
BETTER_AUTH_URL=

# Optional. hostyara-shell BFF's receiver for access.changed events
# ({hid, userId?, appId?}), fired on role/membership/grant/install changes.
# If unset, webhook emission is silently skipped. With the hostyara BFF running
# locally: http://localhost:4001/webhooks/access-changed (its internal listener).
BFF_WEBHOOK_URL=

# Optional, comma-separated. Origins besides BETTER_AUTH_URL that Better-Auth
# accepts on cookie-authenticated POSTs. The hostyara BFF calls this service
# with Origin = its BFF_PUBLIC_URL, so that origin must be listed here
# (locally: http://localhost:3000, and run this service with PORT=3001).
TRUSTED_ORIGINS=

POSTGRES_HOST=localhost
POSTGRES_DB=identity_service
POSTGRES_DB_CONTAINER_NAME=${POSTGRES_DB}-db
POSTGRES_USER=admin
POSTGRES_PASSWORD=super_secret_password
POSTGRES_PORT=5432

PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=super_secret_password
PGADMIN_PORT=5050
# Only needed if you run several pgadmin servers
PGADMIN_CONFIG_SESSION_COOKIE_NAME="'ids_pga4_session'"